<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>

  <template class="RufinIpodPageView" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <style><class name="route-content"/><class name="ipod-page"/></style>
    <child>
      <object class="GtkRevealer" id="notice_revealer">
        <property name="transition-type">slide-down</property>
        <property name="reveal-child">false</property>
        <property name="margin-bottom">12</property>
        <child>
          <object class="GtkBox" id="notice_box">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <style><class name="ipod-notice"/></style>
            <child>
              <object class="GtkImage">
                <property name="icon-name">dialog-warning-symbolic</property>
                <property name="valign">start</property>
                <style><class name="dim-label"/></style>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">2</property>
                <child>
                  <object class="GtkLabel" id="notice_heading">
                    <property name="label" translatable="yes">Sync was interrupted</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="notice_detail">
                    <property name="wrap">true</property>
                    <property name="xalign">0</property>
                    <style><class name="muted"/></style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkStack" id="state_stack">
        <property name="transition-type">crossfade</property>
        <property name="transition-duration">160</property>
        <property name="vexpand">true</property>
        <property name="hexpand">true</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">no-ipod</property>
            <property name="child">
              <object class="GtkBox" id="no_ipod_view">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="valign">center</property>
                <property name="halign">center</property>
                <style><class name="empty-state"/></style>
                <child>
                  <object class="GtkImage" id="no_ipod_icon">
                    <property name="icon-name">rufin-ipod-symbolic</property>
                    <property name="pixel-size">64</property>
                    <property name="halign">center</property>
                    <style><class name="dim-label"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="no_ipod_heading">
                    <property name="label" translatable="yes">No iPod detected</property>
                    <style><class name="section-heading"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="no_ipod_body">
                    <property name="label" translatable="yes">Connect a supported iPod (Video or Classic) to sync music, playlists, and statistics.</property>
                    <property name="wrap">true</property>
                    <property name="justify">center</property>
                    <property name="max-width-chars">46</property>
                    <style><class name="muted"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="status_row">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <property name="halign">center</property>
                    <property name="margin-top">4</property>
                    <child>
                      <object class="GtkBox" id="status_dot">
                        <property name="width-request">8</property>
                        <property name="height-request">8</property>
                        <property name="valign">center</property>
                        <style><class name="ipod-status-dot"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="status_label">
                        <style><class name="muted"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="scan_button">
                    <property name="label" translatable="yes">Scan again</property>
                    <property name="halign">center</property>
                    <property name="margin-top">8</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">connecting</property>
            <property name="child">
              <object class="GtkBox" id="connecting_view">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="valign">center</property>
                <property name="halign">center</property>
                <style><class name="empty-state"/></style>
                <child>
                  <object class="GtkSpinner" id="connecting_spinner">
                    <property name="spinning">true</property>
                    <property name="halign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="connecting_heading">
                    <style><class name="section-heading"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="connecting_device">
                    <style><class name="muted"/></style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">unavailable</property>
            <property name="child">
              <object class="GtkBox" id="unavailable_view">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="valign">center</property>
                <property name="halign">center</property>
                <style><class name="empty-state"/></style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">dialog-warning-symbolic</property>
                    <property name="pixel-size">64</property>
                    <property name="halign">center</property>
                    <style><class name="dim-label"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="unavailable_heading">
                    <style><class name="section-heading"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="unavailable_diagnostic">
                    <property name="wrap">true</property>
                    <property name="justify">center</property>
                    <property name="max-width-chars">46</property>
                    <style><class name="muted"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="unavailable_hint">
                    <property name="label" translatable="yes">Check the libgpod backend installation, then scan again.</property>
                    <property name="wrap">true</property>
                    <property name="justify">center</property>
                    <property name="max-width-chars">46</property>
                    <style><class name="muted"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="unavailable_scan_button">
                    <property name="label" translatable="yes">Scan again</property>
                    <property name="halign">center</property>
                    <property name="margin-top">8</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">ready</property>
            <property name="child">
              <object class="GtkBox" id="ready_shell">
                <property name="orientation">horizontal</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <child>
                  <object class="GtkBox" id="ready_sidebar">
                    <property name="orientation">vertical</property>
                    <property name="width-request">240</property>
                    <style><class name="ipod-sidebar"/></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">10</property>
                        <property name="margin-start">15</property>
                        <property name="margin-end">15</property>
                        <property name="margin-top">15</property>
                        <property name="margin-bottom">15</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">rufin-ipod-symbolic</property>
                            <property name="pixel-size">28</property>
                            <property name="valign">start</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="hexpand">true</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkLabel" id="sidebar_name">
                                <property name="xalign">0</property>
                                <property name="ellipsize">end</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="sidebar_badge">
                                <property name="xalign">0</property>
                                <property name="halign">start</property>
                                <style><class name="ipod-badge"/></style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="sidebar_scan_button">
                            <property name="icon-name">view-refresh-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Scan for connected iPods</property>
                            <property name="valign">start</property>
                            <style><class name="flat"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator"/>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="margin-top">15</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Settings</property>
                            <property name="xalign">0</property>
                            <property name="margin-start">15</property>
                            <property name="margin-end">15</property>
                            <property name="margin-bottom">5</property>
                            <style><class name="ipod-nav-title"/></style>
                          </object>
                        </child>
                        <!-- Nav furniture (b014_plan §3.2): only Summary is
                             real; the rest are greyed placeholders for the
                             sync-options pages B-015+ adds. -->
                        <child>
                          <object class="GtkListBox">
                            <property name="selection-mode">none</property>
                            <style><class name="ipod-nav-list"/></style>
                            <child>
                              <object class="GtkListBoxRow">
                                <style><class name="ipod-nav-active"/></style>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Summary</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <property name="sensitive">false</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Music</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <property name="sensitive">false</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Movies</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <property name="sensitive">false</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">TV Shows</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <property name="sensitive">false</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Photos</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="margin-top">15</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">On my device</property>
                            <property name="xalign">0</property>
                            <property name="margin-start">15</property>
                            <property name="margin-end">15</property>
                            <property name="margin-bottom">5</property>
                            <style><class name="ipod-nav-title"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBox">
                            <property name="selection-mode">none</property>
                            <style><class name="ipod-nav-list"/></style>
                            <child>
                              <object class="GtkListBoxRow">
                                <property name="sensitive">false</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Music</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <property name="sensitive">false</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Movies</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <property name="sensitive">false</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">TV Shows</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <property name="sensitive">false</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Audiobooks</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <property name="sensitive">false</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Purchases</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator">
                    <property name="orientation">vertical</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="ready_content_column">
                    <property name="orientation">vertical</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <property name="hscrollbar-policy">never</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                            <property name="margin-start">35</property>
                            <property name="margin-end">35</property>
                            <property name="margin-top">25</property>
                            <property name="margin-bottom">25</property>
                        <child>
                          <object class="GtkLabel" id="ready_heading">
                            <property name="xalign">0</property>
                            <style><class name="section-heading"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="overview_info_box">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <style><class name="ipod-info-box"/></style>
                            <child>
                              <object class="GtkGrid">
                                <property name="row-spacing">8</property>
                                <property name="column-spacing">24</property>
                                <property name="valign">start</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Capacity</property>
                                    <property name="xalign">0</property>
                                    <style><class name="dim-label"/></style>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="capacity_value">
                                    <property name="xalign">0</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Serial number</property>
                                    <property name="xalign">0</property>
                                    <style><class name="dim-label"/></style>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="serial_value">
                                    <property name="xalign">0</property>
                                    <property name="selectable">true</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Format</property>
                                    <property name="xalign">0</property>
                                    <style><class name="dim-label"/></style>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="format_value">
                                    <property name="xalign">0</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Software version</property>
                                    <property name="xalign">0</property>
                                    <style><class name="dim-label"/></style>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">3</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <property name="valign">start</property>
                                    <child>
                                      <object class="GtkLabel" id="firmware_value">
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">8</property>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="label" translatable="yes">Update</property>
                                            <property name="sensitive">false</property>
                                          </object>
                                        </child>
                                        <child>
                                          <!-- Furniture (b014_plan D-6): restore
                                               wipes the pod — permanently out
                                               of scope, never enabled. -->
                                          <object class="GtkButton">
                                            <property name="label" translatable="yes">Restore iPod…</property>
                                            <property name="sensitive">false</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">3</property>
                                    </layout>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="warning_label">
                                <property name="visible">false</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <style><class name="ipod-warning"/></style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Options</property>
                            <property name="xalign">0</property>
                            <property name="margin-top">12</property>
                            <style><class name="section-heading"/></style>
                          </object>
                        </child>
                        <child>
                          <!-- Greyed furniture (b014_plan D-6): none of these
                               options exist yet; B-015 defines the real sync
                               options. The demo's bitrate select is static
                               text here. -->
                          <object class="GtkBox" id="overview_options_box">
                            <property name="orientation">vertical</property>
                            <property name="spacing">10</property>
                            <style><class name="ipod-info-box"/></style>
                            <child>
                              <object class="GtkCheckButton">
                                <property name="label" translatable="yes">Open iTunes when this iPod is connected</property>
                                <property name="sensitive">false</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton">
                                <property name="label" translatable="yes">Sync only checked songs and videos</property>
                                <property name="sensitive">false</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton">
                                <property name="label" translatable="yes">Convert higher bit rate songs to 256 kbps AAC</property>
                                <property name="sensitive">false</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton">
                                <property name="label" translatable="yes">Manually manage music and videos</property>
                                <property name="sensitive">false</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton">
                                <property name="label" translatable="yes">Enable disk use</property>
                                <property name="sensitive">false</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton">
                                <property name="label" translatable="yes">Reset warnings</property>
                                <property name="sensitive">false</property>
                                <property name="halign">start</property>
                                <property name="margin-top">8</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkRevealer" id="sync_sheet_revealer">
                        <property name="transition-type">slide-down</property>
                        <property name="reveal-child">false</property>
                        <child>
                          <object class="GtkBox" id="sync_sheet">
                            <property name="orientation">vertical</property>
                            <style><class name="ipod-sync-sheet"/></style>
                            <child>
                              <object class="GtkBox" id="sync_sheet_header">
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <style><class name="ipod-sync-header"/></style>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">8</property>
                                    <child>
                                      <object class="GtkSpinner" id="sync_sheet_spinner">
                                        <property name="visible">false</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="sync_sheet_heading">
                                        <property name="xalign">0</property>
                                        <property name="hexpand">true</property>
                                        <style><class name="ipod-sheet-heading"/></style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="sync_sheet_summary">
                                    <property name="xalign">0</property>
                                    <property name="wrap">true</property>
                                    <style><class name="muted"/></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="sync_sheet_running">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel" id="sync_sheet_action">
                                        <property name="xalign">0</property>
                                        <property name="ellipsize">end</property>
                                        <property name="single-line-mode">true</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkProgressBar" id="sync_progress_bar">
                                        <property name="hexpand">true</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <child>
                                          <object class="GtkLabel" id="sync_step_label">
                                            <property name="xalign">0</property>
                                            <property name="hexpand">true</property>
                                            <style><class name="muted"/></style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="sync_step_fraction">
                                            <property name="xalign">1</property>
                                            <style><class name="muted"/></style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow" id="sync_sheet_body_scroll">
                                <property name="vexpand">true</property>
                                <property name="hscrollbar-policy">never</property>
                                <property name="max-content-height">380</property>
                                <style><class name="ipod-sync-body"/></style>
                                <child>
                                  <object class="GtkBox" id="sync_sheet_body">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="sync_sheet_footer">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">8</property>
                                <property name="halign">end</property>
                                <style><class name="ipod-sync-footer"/></style>
                                <child>
                                  <object class="GtkButton" id="sync_sheet_cancel">
                                    <property name="label" translatable="yes">Cancel</property>
                                    <style><class name="flat"/></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="sync_sheet_apply">
                                    <property name="label" translatable="yes">Apply sync</property>
                                    <style><class name="suggested-action"/></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="sync_sheet_close">
                                    <property name="label" translatable="yes">Close</property>
                                    <style><class name="flat"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="ready_bottom_bar">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">20</property>
                        <style><class name="ipod-bottom-bar"/></style>
                        <child>
                          <object class="GtkProgressBar" id="storage_bar">
                            <property name="hexpand">true</property>
                            <property name="valign">center</property>
                            <property name="show-text">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="dry_run_check">
                            <property name="label" translatable="yes">Dry Run</property>
                            <property name="tooltip-text" translatable="yes">Show what the sync would change without writing to the iPod or the library.</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSpinner" id="running_spinner">
                            <property name="visible">false</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="sync_button">
                            <property name="label" translatable="yes">Sync</property>
                            <property name="sensitive">false</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">error</property>
            <property name="child">
              <object class="GtkBox" id="error_view">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="valign">center</property>
                <property name="halign">center</property>
                <style><class name="empty-state"/></style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">dialog-error-symbolic</property>
                    <property name="pixel-size">64</property>
                    <property name="halign">center</property>
                    <style><class name="dim-label"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="error_heading">
                    <style><class name="section-heading"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="error_diagnostic">
                    <property name="wrap">true</property>
                    <property name="justify">center</property>
                    <property name="max-width-chars">46</property>
                    <style><class name="error-text"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="error_hint">
                    <property name="label" translatable="yes">Reconnect the iPod and try again.</property>
                    <property name="wrap">true</property>
                    <property name="justify">center</property>
                    <property name="max-width-chars">46</property>
                    <style><class name="muted"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <property name="halign">center</property>
                    <property name="margin-top">8</property>
                    <child>
                      <object class="GtkButton" id="error_retry_button">
                        <property name="label" translatable="yes">Retry</property>
                        <style><class name="suggested-action"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="error_scan_button">
                        <property name="label" translatable="yes">Scan again</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">service-dead</property>
            <property name="child">
              <object class="GtkBox" id="service_dead_view">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="valign">center</property>
                <property name="halign">center</property>
                <style><class name="empty-state"/></style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">dialog-warning-symbolic</property>
                    <property name="pixel-size">64</property>
                    <property name="halign">center</property>
                    <style><class name="dim-label"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="dead_heading">
                    <style><class name="section-heading"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="dead_body">
                    <property name="label" translatable="yes">Restart Rufin to reconnect the iPod.</property>
                    <property name="wrap">true</property>
                    <property name="justify">center</property>
                    <property name="max-width-chars">46</property>
                    <style><class name="muted"/></style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </template>

</interface>
